# ---- Root reference .env.example (see backend/ and frontend/ for scoped copies) ----

# Database (PostgreSQL / Supabase pooled connection string)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/cityfix

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Secure admin seeding (never allow self-registration as admin)
ADMIN_SEED_EMAIL=admin@cityfix.app
ADMIN_SEED_PASSWORD=ChangeMeStrong!123
ADMIN_SEED_NAME=CityFix Admin

# Hindsight memory
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=
HINDSIGHT_MEMORY_BANK=cityfix
HINDSIGHT_TIMEOUT=60

# LLM model config (used through Hindsight reflect / bank disposition)
LLM_MODEL=default

# URLs / CORS
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173

# File storage
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# Workers
RUN_INLINE_WORKER=true
MEMORY_WORKER_INTERVAL_SECONDS=5
MEMORY_MAX_RETRIES=5
